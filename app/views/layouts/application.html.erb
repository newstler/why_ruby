<!DOCTYPE html>
<html>
  <head>
    <!-- Essential Meta Tags (First Priority) -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    
    <!-- Page Title -->
    <% if content_for?(:full_title) %>
      <title><%= yield(:full_title) %></title>
    <% else %>
      <% page_title = yield(:title).presence %>
      <title><%= page_title ? "Why Ruby? — #{page_title}" : "Why Ruby?" %></title>
    <% end %>
    
    <!-- Rails Security Tags -->
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <!-- Custom head content from views (or defaults if not provided) -->
    <% if content_for?(:head) %>
      <%= yield(:head) %>
    <% else %>
      <!-- Default Meta Tags -->
      <meta name="description" content="<%= t('meta.default.summary') %>">
      <meta name="keywords" content="<%= t('meta.default.keywords') %>">
      <meta name="author" content="<%= t('meta.default.author') %>">
      <meta name="robots" content="index, follow">
      <link rel="canonical" href="<%= request.original_url %>">
      
      <!-- Default Open Graph / Facebook Meta Tags -->
      <meta property="og:type" content="website">
      <meta property="og:url" content="<%= request.original_url %>">
      <meta property="og:title" content="<%= full_page_title(yield(:title).presence) %>">
      <meta property="og:description" content="<%= t('meta.default.summary') %>">
      <meta property="og:image" content="<%= versioned_og_image_url %>">
      <meta property="og:site_name" content="<%= t('meta.site.name') %>">
      <meta property="og:locale" content="<%= I18n.locale.to_s.gsub('-', '_') %>">
      
      <!-- Default Twitter Card Meta Tags -->
      <meta name="twitter:card" content="summary_large_image">
      <meta name="twitter:url" content="<%= request.original_url %>">
      <meta name="twitter:title" content="<%= full_page_title(yield(:title).presence) %>">
      <meta name="twitter:description" content="<%= t('meta.default.summary') %>">
      <meta name="twitter:image" content="<%= versioned_og_image_url %>">
      <meta name="twitter:site" content="<%= t('meta.social.twitter_site') %>">
      <meta name="twitter:creator" content="<%= t('meta.social.twitter_creator') %>">
    <% end %>
    
    <!-- PWA and Mobile App Meta Tags -->
    <meta name="theme-color" content="#dc2626">
    <% if content_for?(:full_title) %>
      <meta name="application-name" content="<%= t('meta.community.site_name') %>">
      <meta name="apple-mobile-web-app-title" content="<%= t('meta.community.site_name') %>">
    <% else %>
      <meta name="application-name" content="<%= t('meta.site.application_name') %>">
      <meta name="apple-mobile-web-app-title" content="<%= t('meta.site.apple_app_title') %>">
    <% end %>
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="msapplication-TileColor" content="#dc2626">
    <meta name="msapplication-TileImage" content="/android-chrome-192x192.png">
    
    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Martian+Mono:wght@100..800&display=swap" rel="stylesheet">
    
    <!-- Favicons and Icons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png">
    <link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png">
    <link rel="icon" type="image/png" href="/icon.png">
    <link rel="icon" type="image/svg+xml" href="/icon.svg">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    
    
    <!-- Stylesheets and JavaScript -->
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    
    <!-- Nullitics Analytics (privacy-first, no cookies, GDPR compliant) -->
    <% country_code = client_country_code %>
    <script type="text/javascript">new Image().src='https://nullitics.com/n.gif?u=' + encodeURI(location.href) + '&r=' + encodeURI(document.referrer) + '&d=' + screen.width<%= "&c=#{country_code}" if country_code.present? %>;</script>
  </head>

  <body class="bg-gray-50 min-h-screen flex flex-col">
    <!-- Nullitics noscript fallback -->
    <noscript><img src="https://nullitics.com/n.gif?u=<%= request.original_url %><%= "&c=#{country_code}" if country_code.present? %>" alt="" style="position:absolute;left:-9999px" /></noscript>

    <nav class="bg-white shadow-sm sticky top-0 z-50 py-4" data-controller="mobile-menu" data-action="click@window->mobile-menu#hide">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <% centered_mobile_nav = controller_name == 'users' && ['index', 'show'].include?(action_name) %>
        <div class="flex items-center h-16 <%= centered_mobile_nav ? 'justify-center' : 'justify-between' %>">
          <% if content_for?(:nav_minimal) %>
            <!-- Minimal nav - just centered logo -->
            <div class="flex-shrink-0">
              <% if content_for?(:header_logo) %>
                <%= yield(:header_logo) %>
              <% else %>
                <%= link_to root_path, class: "text-4xl font-black text-red-600 whitespace-nowrap inline-flex items-center" do %>
                  Why <%= image_tag "heart.webp", class: "h-12 w-12 mx-1 inline-block", alt: "" %> Ruby?
                <% end %>
              <% end %>
            </div>
          <% else %>
          <!-- Logo on the left -->
          <div class="flex-shrink-0 lg:flex-1">
            <% if content_for?(:header_logo) %>
              <%= yield(:header_logo) %>
            <% else %>
              <%= link_to root_path, class: "text-4xl font-black text-red-600 whitespace-nowrap inline-flex items-center" do %>
                Why <%= image_tag "heart.webp", class: "h-12 w-12 mx-1 inline-block", alt: "" %> Ruby?
              <% end %>
            <% end %>
          </div>

          <!-- Desktop navigation - hidden on mobile and tablets in portrait -->
          <div class="hidden lg:flex justify-center items-center space-x-4">
            <% if content_for?(:header_nav) %>
              <%= yield(:header_nav) %>
            <% else %>
              <% Category.with_posts.ordered.each do |category| %>
                <% if category.is_success_story? && has_success_stories? %>
                  <%= link_to category.name, category_path(category),
                      class: "#{category_menu_active?(category) ? 'bg-red-100 text-red-700' : 'text-gray-600 hover:bg-gray-100'} px-3 py-2 rounded-md text-sm font-medium whitespace-nowrap" %>
                <% elsif !category.is_success_story? %>
                  <%= link_to category.name, category_path(category),
                      class: "#{category_menu_active?(category) ? 'bg-red-100 text-red-700' : 'text-gray-600 hover:bg-gray-100'} px-3 py-2 rounded-md text-sm font-medium whitespace-nowrap" %>
                <% end %>
              <% end %>

              <%= link_to "Community", community_index_url,
                  class: "#{community_menu_active? ? 'bg-red-100 text-red-700' : 'text-gray-600 hover:bg-gray-100'} px-3 py-2 rounded-md text-sm font-medium whitespace-nowrap" %>

              <% if user_signed_in? %>
                <%
                  is_success_story = @category&.is_success_story? || (controller_name == 'posts' && @post&.success_story?)
                  new_post_params = is_success_story ? { type: 'success_story' } : {}
                  new_post_params[:category_id] = @category.id if @category.present? && !is_success_story
                %>
                <%= link_to new_post_path(new_post_params), class: "p-2 text-gray-400 hover:text-gray-500 rounded-full hover:bg-gray-100" do %>
                  <%= inline_svg_tag "plus.svg", class: "h-6 w-6" %>
                <% end %>
              <% end %>
            <% end %>
          </div>
          
          <!-- Desktop user section - hidden on mobile and tablets in portrait -->
          <div class="hidden lg:flex items-center lg:flex-1 lg:justify-end">
            <% if user_signed_in? %>
              <div class="relative" data-controller="dropdown">
                <button type="button" class="flex items-center gap-x-1 text-sm rounded-full cursor-pointer hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 p-2" data-action="click->dropdown#toggle click@window->dropdown#hide">
                  <% if current_user.avatar_url.present? %>
                    <%= image_tag current_user.avatar_url, alt: current_user.display_name, class: "h-8 w-8 rounded-full" %>
                  <% else %>
                    <span class="h-8 w-8 rounded-full bg-gray-300 flex items-center justify-center">
                      <%= current_user.display_name.first.upcase %>
                    </span>
                  <% end %>
                  <span class="ml-2 text-gray-700 font-medium"><%= current_user.display_name %></span>
                  <%= inline_svg_tag "chevron-down.svg", class: "ml-1 h-5 w-5 text-gray-400" %>
                </button>
                
                <div class="hidden origin-top-right absolute right-0 mt-2 w-56 divide-y divide-gray-100 rounded-md bg-white shadow-lg ring-1 ring-black/5 focus:outline-none" data-dropdown-target="menu">
                  <div class="py-1">
                    <%= link_to "Profile", user_path(current_user), class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-900 focus:bg-gray-100 focus:text-gray-900 focus:outline-none cursor-pointer" %>
                  </div>
                  <% if current_user.admin? %>
                    <div class="py-1">
                      <%= link_to "Admin Panel", "/avo", class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-900 focus:bg-gray-100 focus:text-gray-900 focus:outline-none cursor-pointer" %>
                    </div>
                  <% end %>
                  <div class="py-1">
                    <%= button_to "Sign out", destroy_user_session_path, method: :delete, data: { turbo: false }, class: "block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-900 focus:bg-gray-100 focus:text-gray-900 focus:outline-none cursor-pointer" %>
                  </div>
                </div>
              </div>
            <% else %>
              <%= render "shared/github_signin_button" %>
            <% end %>
          </div>
          
          <!-- Mobile menu button -->
          <div class="lg:hidden">
            <button type="button"
                    class="text-gray-500 hover:text-gray-600 focus:outline-none focus:text-gray-600 p-3 -mr-3 rounded-md touch-manipulation"
                    data-action="click->mobile-menu#toggle"
                    aria-label="Toggle navigation menu"
                    aria-expanded="false"
                    data-mobile-menu-target="button">
              <%= inline_svg_tag "menu.svg", class: "h-6 w-6" %>
            </button>
          </div>
          <% end %> <%# end nav_minimal if/else %>
        </div>
        
        <% unless content_for?(:nav_minimal) %>
        <!-- Mobile menu -->
        <div class="hidden lg:hidden" data-mobile-menu-target="menu">
          <div class="pt-4 pb-3 border-t border-gray-200">
            <!-- Categories -->
            <div class="space-y-1 px-2">
              <% if content_for?(:header_nav_mobile) %>
                <%= yield(:header_nav_mobile) %>
              <% else %>
                <% Category.with_posts.ordered.limit(7).each do |category| %>
                  <% if category.is_success_story? && has_success_stories? %>
                    <%= link_to category.name, category_path(category),
                        class: "#{category_menu_active?(category) ? 'bg-red-100 text-red-700' : 'text-gray-600 hover:bg-gray-100'} block px-3 py-2 rounded-md text-base font-medium" %>
                  <% elsif !category.is_success_story? %>
                    <%= link_to category.name, category_path(category),
                        class: "#{category_menu_active?(category) ? 'bg-red-100 text-red-700' : 'text-gray-600 hover:bg-gray-100'} block px-3 py-2 rounded-md text-base font-medium" %>
                  <% end %>
                <% end %>
                <%= link_to "Community", community_index_url,
                    class: "#{community_menu_active? ? 'bg-red-100 text-red-700' : 'text-gray-600 hover:bg-gray-100'} block px-3 py-2 rounded-md text-base font-medium" %>
              <% end %>
            </div>

            <% if user_signed_in? %>
              <!-- New post button -->
              <div class="mt-3 px-2">
                <%
                  is_success_story = @category&.is_success_story? || (controller_name == 'posts' && @post&.success_story?)
                  new_post_params = is_success_story ? { type: 'success_story' } : {}
                  new_post_params[:category_id] = @category.id if @category.present? && !is_success_story
                %>
                <%= link_to new_post_path(new_post_params), class: "flex items-center px-3 py-2 rounded-md text-base font-medium text-gray-600 hover:bg-gray-100" do %>
                  <%= inline_svg_tag "plus.svg", class: "h-5 w-5 mr-2" %>
                  New Post
                <% end %>
              </div>

              <!-- User section -->
              <div class="mt-3 border-t border-gray-200 pt-3">
                <div class="flex items-center px-5">
                  <% if current_user.avatar_url.present? %>
                    <%= image_tag current_user.avatar_url, alt: current_user.display_name, class: "h-10 w-10 rounded-full" %>
                  <% else %>
                    <span class="h-10 w-10 rounded-full bg-gray-300 flex items-center justify-center">
                      <%= current_user.display_name.first.upcase %>
                    </span>
                  <% end %>
                  <div class="ml-3">
                    <div class="text-base font-medium text-gray-800"><%= current_user.display_name %></div>
                  </div>
                </div>
                <div class="mt-3 space-y-1 px-2">
                  <%= link_to "Profile", user_path(current_user), class: "block px-3 py-2 rounded-md text-base font-medium text-gray-600 hover:bg-gray-100" %>
                  <% if current_user.admin? %>
                    <%= link_to "Admin Panel", "/avo", class: "block px-3 py-2 rounded-md text-base font-medium text-gray-600 hover:bg-gray-100" %>
                  <% end %>
                  <%= button_to "Sign out", destroy_user_session_path, method: :delete, data: { turbo: false }, class: "block w-full text-left px-3 py-2 rounded-md text-base font-medium text-gray-600 hover:bg-gray-100" %>
                </div>
              </div>
            <% else %>
              <div class="mt-3 px-2">
                <%= render "shared/github_signin_button", mobile: true %>
              </div>
            <% end %>
          </div>
        </div>
        <% end %>
      </div>
    </nav>

    <% if notice.present? %>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
        <div class="bg-green-50 border-l-4 border-green-400 p-4 rounded-r-md">
          <p class="text-sm text-green-700 text-center"><%= notice %></p>
        </div>
      </div>
    <% end %>
    
    <% if alert.present? %>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
        <div class="bg-red-50 border-l-4 border-red-400 p-4 rounded-r-md">
          <p class="text-sm text-red-700 text-center"><%= alert %></p>
        </div>
      </div>
    <% end %>

    <main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
      <%= yield %>
    </main>

    <footer class="max-w-7xl mx-auto mt-auto mb-12 px-4 sm:px-6 lg:px-8 w-full">
      <!-- Desktop layout with custom grid -->
      <div class="hidden md:flex md:items-center md:justify-between md:gap-8">
        <!-- Left column -->
        <div class="text-left text-xs text-gray-400 flex-1">
          <div class="lg:inline-block">
            <div class="lg:inline">&copy; <%= Date.current.year %>
            <%= link_to "Yuri Sidorov", "https://yurisidorov.com", class: "underline hover:text-gray-600 transition", target: "_blank", rel: "noopener" %> — <em><%= link_to "Hire me!", "https://cal.com/yurisidorov/", class: "underline hover:text-gray-600 transition", target: "_blank", rel: "noopener" %></em></div>
            <div class="lg:inline">Built with ❤️ in
            <%= link_to "Ruby #{RUBY_VERSION}", "https://www.ruby-lang.org/", class: "underline hover:text-gray-600 transition", target: "_blank", rel: "noopener" %>
            on
            <%= link_to "Rails #{Rails.version}", "https://rubyonrails.org", class: "underline hover:text-gray-600 transition", target: "_blank", rel: "noopener" %>.</div>
          </div>
          <div>This project is open source — <%= link_to "contribute on GitHub", "https://github.com/newstler/why_ruby", class: "underline hover:text-gray-600 transition", target: "_blank", rel: "noopener" %>. Monitored with <%= link_to "RorVsWild", "https://www.rorvswild.com/applications/136539/requests", class: "underline hover:text-gray-600 transition", target: "_blank", rel: "noopener" %>.</div>
        </div>

        <!-- Center column - narrower for logo -->
        <div class="px-8">
          <%= link_to "https://yurisidorov.com", class: "group", target: "_blank", rel: "noopener" do %>
            <%= inline_svg_tag "capedbot-logo.svg", class: "h-8 w-auto fill-[#8DA0AE] group-hover:fill-red-600 transition-colors duration-300" %>
          <% end %>
        </div>

        <!-- Right column -->
        <div class="text-xs text-right text-gray-400 flex-1">
          By using this site you agree with our
          <%= link_to "cookie policy", cookie_policy_path, class: "underline hover:text-gray-600 transition" %>.
          <br />
          <%= link_to "Privacy", privacy_policy_path, class: "underline hover:text-gray-600 transition" %>
          <span class="mx-1">•</span>
          <%= link_to "Terms", terms_of_service_path, class: "underline hover:text-gray-600 transition" %>
          <span class="mx-1">•</span>
          <%= link_to "Legal", legal_notice_path, class: "underline hover:text-gray-600 transition" %>
        </div>
      </div>

      <!-- Mobile/Tablet layout - stacked -->
      <div class="md:hidden space-y-6">
        <!-- Logo at top on mobile -->
        <div class="flex justify-center">
          <%= link_to "https://yurisidorov.com", class: "group", target: "_blank", rel: "noopener" do %>
            <%= inline_svg_tag "capedbot-logo.svg", class: "h-8 w-auto fill-[#8DA0AE] group-hover:fill-red-600 transition-colors duration-300" %>
          <% end %>
        </div>

        <!-- Copyright and project info -->
        <div class="text-center text-xs text-gray-400 space-y-1">
          <div>&copy; <%= Date.current.year %> <%= link_to "Yuri Sidorov", "https://yurisidorov.com", class: "underline hover:text-gray-600 transition", target: "_blank", rel: "noopener" %> — <em><%= link_to "Hire me!", "https://cal.com/yurisidorov/", class: "underline hover:text-gray-600 transition", target: "_blank", rel: "noopener" %></em></div>
          <div>Built with ❤️ in <%= link_to "Ruby #{Ruby::VERSION}", "https://www.ruby-lang.org/", class: "underline hover:text-gray-600 transition", target: "_blank", rel: "noopener" %>
            on <%= link_to "Rails #{Rails.version}", "https://rubyonrails.org", class: "underline hover:text-gray-600 transition", target: "_blank", rel: "noopener" %>.</div>
          <div>This project is open source — <%= link_to "contribute on GitHub", "https://github.com/newstler/why_ruby", class: "underline hover:text-gray-600 transition", target: "_blank", rel: "noopener" %>.</div>
          <div>Monitored with <%= link_to "RorVsWild", "https://www.rorvswild.com/applications/136539/requests", class: "underline hover:text-gray-600 transition", target: "_blank", rel: "noopener" %>.</div>
        </div>

        <!-- Legal links -->
        <div class="text-center text-xs text-gray-400 space-y-1">
          <div>By using this site you agree with our <%= link_to "cookie policy", cookie_policy_path, class: "underline hover:text-gray-600 transition" %>.</div>
          <div>
            <%= link_to "Privacy", privacy_policy_path, class: "underline hover:text-gray-600 transition" %>
            <span class="mx-1">•</span>
            <%= link_to "Terms", terms_of_service_path, class: "underline hover:text-gray-600 transition" %>
            <span class="mx-1">•</span>
            <%= link_to "Legal", legal_notice_path, class: "underline hover:text-gray-600 transition" %>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
