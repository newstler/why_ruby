<%# Testimonial carousel for home page %>
<% if testimonials.any? %>
  <div class="pt-8 md:pt-14 pb-2 md:pb-4" data-controller="testimonial-carousel">
    <div class="grid grid-cols-[auto_1fr_auto] items-center gap-4 md:gap-8">

      <%# Left arrow %>
      <% if testimonials.size > 1 %>
        <button type="button"
                class="self-center text-gray-300 hover:text-red-600 transition-colors cursor-pointer p-2"
                data-action="testimonial-carousel#previous">
          <svg class="w-10 h-10 md:w-12 md:h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"></path>
          </svg>
        </button>
      <% else %>
        <div></div>
      <% end %>

      <%# Middle column: slides %>
      <div class="max-w-4xl mx-auto w-full">
        <% testimonials.each_with_index do |testimonial, index| %>
          <div class="<%= index == 0 ? '' : 'hidden' %>"
               data-testimonial-carousel-target="slide">

            <%# Heading area %>
            <% if testimonial.heading.present? %>
              <h2 class="text-5xl md:text-7xl font-serif italic text-red-600 mb-6">
                <%= testimonial.heading %>
              </h2>
            <% end %>

            <% if testimonial.subheading.present? %>
              <h3 class="text-2xl md:text-3xl font-bold text-gray-900 leading-tight mb-2">
                <%= raw testimonial.subheading.split('.').map { |s| s.strip }.reject(&:blank?).map { |s| ERB::Util.html_escape(s) + "." }.join("<br>") %>
              </h3>
            <% end %>

            <% if testimonial.body_text.present? %>
              <p class="text-gray-500 text-base md:text-lg mt-6 mb-12 max-w-3xl leading-relaxed">
                <%= testimonial.body_text %>
              </p>
            <% end %>

            <%# Quote + User layout %>
            <div class="flex flex-col md:flex-row gap-6 md:gap-8 md:items-end mt-8">
              <%# Quote block %>
              <div class="flex-1 relative">
                <span class="absolute -top-8 -left-10 text-7xl text-red-600 font-serif leading-none select-none">&ldquo;</span>
                <blockquote class="relative bg-white border-2 border-red-200 rounded-lg p-6 md:p-8">
                  <p class="text-gray-600 text-base md:text-lg italic leading-relaxed">
                    <%= testimonial.quote %>
                  </p>
                  <%# Speech bubble tail pointing right toward user %>
                  <span class="hidden md:block absolute -right-4 bottom-6 w-0 h-0 border-t-[12px] border-t-transparent border-b-[12px] border-b-transparent border-l-[16px] border-l-red-200"></span>
                  <span class="hidden md:block absolute -right-[14px] bottom-[26px] w-0 h-0 border-t-[10px] border-t-transparent border-b-[10px] border-b-transparent border-l-[14px] border-l-white"></span>
                </blockquote>
              </div>

              <%# User tile %>
              <div class="flex-shrink-0 w-full max-w-sm flex items-end [&_img]:ring-4 [&_img]:ring-gray-200 [&_span.rounded-full]:ring-4 [&_span.rounded-full]:ring-gray-200">
                <%= render "users/user_tile", user: testimonial.user, frameless: true %>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <%# Right arrow %>
      <% if testimonials.size > 1 %>
        <button type="button"
                class="self-center text-gray-300 hover:text-red-600 transition-colors cursor-pointer p-2"
                data-action="testimonial-carousel#next">
          <svg class="w-10 h-10 md:w-12 md:h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7"></path>
          </svg>
        </button>
      <% else %>
        <div></div>
      <% end %>

    </div>
  </div>
<% end %>
