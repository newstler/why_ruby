<%# Set page title for home page %>
<% content_for(:title) { "Discover why Ruby continues to be a beloved language for developers worldwide" } %>

<%# Use minimal nav (centered logo only, community-style styling) %>
<%= render "shared/minimal_nav", before_heart: "Why", after_heart: "Ruby?", url: root_path %>

<div>
  <%# Testimonial Carousel %>
  <%= render "home/testimonial_carousel", testimonials: @testimonials %>

  <%# Navigation buttons + Sign in - same style as main nav %>
  <%# Sticky on tablet+ (min-width: 640px AND min-height: 500px) but not horizontal phones %>
  <div data-controller="sticky-nav">
    <div class="mt-16 mb-16" data-sticky-nav-target="nav">
      <%# Desktop/Tablet: show all buttons %>
      <div class="hidden [@media(min-width:640px)_and_(min-height:500px)]:flex flex-wrap justify-center items-center gap-2">
        <% Category.with_posts.ordered.each do |category| %>
          <% next if category.is_success_story? && !has_success_stories? %>
          <%= link_to category.name, category_path(category),
              class: "text-gray-600 bg-gray-100 hover:bg-gray-200 px-3 py-2 rounded-md text-sm font-medium whitespace-nowrap" %>
        <% end %>
        <%= link_to "Community", community_index_url,
            class: "text-gray-600 bg-gray-100 hover:bg-gray-200 px-3 py-2 rounded-md text-sm font-medium whitespace-nowrap" %>
        <% if should_show_mobile_cta? %>
          <%= render "shared/github_signin_button" %>
        <% end %>
      </div>

      <%# Mobile: hamburger menu + sign in button %>
      <div class="[@media(min-width:640px)_and_(min-height:500px)]:hidden flex justify-center items-center gap-3">
        <div class="relative" data-controller="dropdown" data-action="click@window->dropdown#hide">
          <button type="button"
                  class="text-gray-600 bg-gray-100 hover:bg-gray-200 p-2 rounded-md cursor-pointer"
                  data-action="click->dropdown#toggle"
                  aria-label="Open navigation menu">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>

          <div class="hidden absolute left-0 mt-2 w-48 rounded-md bg-white shadow-lg ring-1 ring-black/5 z-50" data-dropdown-target="menu">
            <div class="py-1">
              <% Category.with_posts.ordered.each do |category| %>
                <% next if category.is_success_story? && !has_success_stories? %>
                <%= link_to category.name, category_path(category),
                    class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
              <% end %>
              <%= link_to "Community", community_index_url,
                  class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
            </div>
          </div>
        </div>

        <% if should_show_mobile_cta? %>
          <%= render "shared/github_signin_button" %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- Success Stories Floating Logos (Full Width) -->
<% if @success_stories.size >= 5 %>
  <div class="py-8 md:py-16 bg-gray-50 my-4 md:my-8">
    <h2 class="text-center text-sm font-semibold text-gray-300 tracking-wide uppercase mb-6 md:mb-12">
      Read <%= link_to "success stories", category_path(Category.success_story_category), class: "text-gray-500 hover:text-red-600 transition-colors" %> from
    </h2>
    <div class="relative logo-carousel-container" data-controller="logo-carousel">
      <div class="overflow-hidden relative">
        <div class="logo-carousel-track flex" data-logo-carousel-target="track">
          <!-- Duplicate the logos for seamless infinite scroll with random order -->
          <% shuffled_stories = @success_stories.to_a.shuffle %>
          <% # Create multiple sets for seamless looping %>
          <% 2.times do |set_index| %>
            <% shuffled_stories.each_with_index do |story, index| %>
                      <%= link_to post_path_for(story), 
                class: "logo-item flex-shrink-0 transition-all duration-300 group relative mx-3 md:mx-10",
              data: { 
                action: "mouseenter->logo-carousel#pause mouseleave->logo-carousel#resume mousemove->logo-carousel#showTooltip mouseleave->logo-carousel#hideTooltip",
                story_id: story.id,
                story_title: story.title,
                story_summary: strip_tags(story.summary.presence || story.content)
              } do %>
            <div class="logo-wrapper h-24 flex items-center justify-center">
              <%= raw story.logo_svg %>
            </div>
            <% end %>
            <% end %>
          <% end %>
        </div>
        <!-- Fade gradients on edges -->
        <div class="logo-carousel-fade-left"></div>
        <div class="logo-carousel-fade-right"></div>
      </div>
      
      <!-- Tooltips container - outside overflow hidden -->
      <% shuffled_stories.each do |story| %>
        <div class="logo-tooltip fixed opacity-0 pointer-events-none transition-all duration-200" 
             data-logo-carousel-target="tooltip" 
             data-story-id="<%= story.id %>"
             data-story-url="<%= post_path_for(story) %>"
             style="display: none; z-index: 9999;">
          <div class="bg-white rounded-lg shadow-xl p-4 md:p-5 w-72 md:w-80 border border-gray-100 hover:shadow-2xl transition-shadow cursor-pointer">
            <h3 class="text-lg font-bold text-gray-900 mb-2 leading-tight"><%= story.title %></h3>
            <div class="text-sm text-gray-600 mb-3">
              <%= strip_tags(story.summary.presence || story.content) %>
            </div>
            <div class="flex items-center justify-end">
              <span class="text-red-600 hover:text-red-700 font-semibold text-sm inline-flex items-center gap-1 transition-colors">
                Read more 
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </span>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<div class="space-y-16">

  <!-- Recent Posts -->
  <div class="space-y-4">
    <h2 class="text-center text-sm font-semibold text-gray-300 tracking-wide uppercase my-8 md:my-16">Recent <span>♥️</span> shared</h2>
    <div class="hidden lg:flex gap-6">
      <% # Desktop: 3 columns %>
      <% distribute_to_columns(@posts, num_columns: 3).each do |column_posts| %>
        <div class="flex-1 space-y-6">
          <%= render partial: 'posts/post_tile', collection: column_posts, as: :post %>
        </div>
      <% end %>
    </div>

    <% # Tablet: 2 columns %>
    <div class="hidden md:flex lg:hidden gap-6">
      <% distribute_to_columns(@posts, num_columns: 2).each do |column_posts| %>
        <div class="flex-1 space-y-6">
          <%= render partial: 'posts/post_tile', collection: column_posts, as: :post %>
        </div>
      <% end %>
    </div>
    
    <% # Mobile: 1 column %>
    <div class="md:hidden space-y-6">
      <%= render partial: 'posts/post_tile', collection: @posts, as: :post %>
    </div>
    
    <div class="mt-12 mb-8 text-center">
      <% if user_signed_in? %>
        <%= link_to "Share what you love about Ruby →", new_post_path, 
            class: "text-gray-400 hover:text-gray-600 transition-colors" %>
      <% else %>
        <%= link_to "Share what you love about Ruby →", 
            github_auth_with_return_path(return_to: new_post_path),
            class: "text-gray-400 hover:text-gray-600 transition-colors" %>
      <% end %>
    </div>
  </div>
</div> 