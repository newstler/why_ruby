<%# Shared testimonial display partial - used on home carousel and user profile %>
<div class="text-center">
  <% if testimonial.heading.present? %>
    <h3 class="text-3xl md:text-4xl font-bold text-red-600 italic font-serif mb-2">
      <%= testimonial.heading %>
    </h3>
  <% end %>

  <% if testimonial.subheading.present? %>
    <p class="text-gray-600 text-lg mb-4"><%= testimonial.subheading %></p>
  <% end %>

  <% if testimonial.body_text.present? %>
    <p class="text-gray-500 text-sm md:text-base mb-6 max-w-lg mx-auto"><%= testimonial.body_text %></p>
  <% end %>

  <blockquote class="relative max-w-2xl mx-auto">
    <span class="absolute -top-4 -left-2 text-6xl text-gray-200 font-serif leading-none">&ldquo;</span>
    <p class="text-gray-900 text-lg md:text-xl italic pl-6 pr-6">
      <%= testimonial.quote %>
    </p>
    <span class="absolute -bottom-6 -right-2 text-6xl text-gray-200 font-serif leading-none">&rdquo;</span>
  </blockquote>
</div>
