<%# Set page title %>
<% content_for(:title) { t('meta.users.index.title') } %>

<%# Override header logo for community pages %>
<% content_for :header_logo do %>
  <%= link_to users_path, class: "text-4xl font-black text-red-600 whitespace-nowrap inline-flex items-center" do %>
    Ruby <%= image_tag "heart.webp", class: "h-12 w-12 mx-1 inline-block", alt: "" %> Community
  <% end %>
<% end %>

<%# Override nav menu for community pages %>
<% content_for :header_nav do %>
  <%= link_to "Why Ruby?", cross_domain_url(:primary, "/"), class: "text-gray-600 hover:bg-gray-100 px-3 py-2 rounded-md text-sm font-medium whitespace-nowrap" %>
<% end %>

<% content_for :header_nav_mobile do %>
  <%= link_to "Why Ruby?", cross_domain_url(:primary, "/"), class: "text-gray-600 hover:bg-gray-100 block px-3 py-2 rounded-md text-base font-medium" %>
<% end %>

<%# Override meta tags for community page %>
<% content_for :head do %>
  <!-- SEO Meta Tags -->
  <meta name="description" content="<%= t('meta.users.index.summary') %>">
  <meta name="keywords" content="<%= t('meta.users.index.keywords') %>">
  <link rel="canonical" href="<%= users_url %>">

  <!-- Open Graph / Facebook Meta Tags -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= users_url %>">
  <meta property="og:title" content="<%= full_page_title(t('meta.users.index.title')) %>">
  <meta property="og:description" content="<%= t('meta.users.index.summary') %>">
  <meta property="og:image" content="<%= versioned_og_image_url %>">
  <meta property="og:site_name" content="<%= t('meta.site.name') %>">
  <meta property="og:locale" content="<%= I18n.locale.to_s.gsub('-', '_') %>">

  <!-- Twitter Card Meta Tags -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content="<%= users_url %>">
  <meta name="twitter:title" content="<%= full_page_title(t('meta.users.index.title')) %>">
  <meta name="twitter:description" content="<%= t('meta.users.index.summary') %>">
  <meta name="twitter:image" content="<%= versioned_og_image_url %>">
  <meta name="twitter:site" content="<%= t('meta.social.twitter_site') %>">
  <meta name="twitter:creator" content="<%= t('meta.social.twitter_creator') %>">
<% end %>

<div class="space-y-8">
  <!-- Sticky Header (positioned below main nav) - sticky on tablets (min-width: 768px AND min-height: 600px) but not horizontal phones -->
  <div class="sticky-tablet top-24 z-10 -mx-4 px-4 md:-mx-6 md:px-6 lg:-mx-8 lg:px-8 pt-8 -mt-8 pb-8 md:bg-gradient-to-b md:from-gray-50 md:from-85% md:to-transparent">
    <div class="md:flex md:items-center md:justify-between w-full">
    <p class="text-left text-lg text-gray-600 md:flex-1 min-w-0">
      <% if user_signed_in? %>
        <%= t('users.index.description', count: @total_users_count) %>
      <% else %>
        <%= link_to t('users.index.join'), github_auth_with_return_path, class: "underline hover:text-red-600 transition-colors" %>
        <%= t('users.index.join_suffix', count: @total_users_count) %>
      <% end %>
    </p>

    <div class="relative md:ml-auto mt-2 md:mt-0 flex-shrink-0" data-controller="dropdown">
      <button type="button" class="flex items-center gap-x-1 text-sm rounded-full cursor-pointer bg-gray-100 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 px-3 py-2" data-action="click->dropdown#toggle click@window->dropdown#hide">
        <span class="text-gray-400"><%= t('users.index.sort_label') %>:</span>
        <span class="text-gray-700 font-medium">
          <% effective_sort = (@sort == 'old' ? 'new' : @sort) %>
          <% effective_dir  = (@sort == 'old' ? 'asc' : @dir) %>
          <% closed_label = case effective_sort
             when 'new' then (effective_dir == 'asc' ? t('users.index.sort.new_reverse') : t('users.index.sort.new'))
             when 'projects' then (effective_dir == 'asc' ? t('users.index.sort.projects_reverse') : t('users.index.sort.projects'))
             when 'posts' then (effective_dir == 'asc' ? t('users.index.sort.posts_reverse') : t('users.index.sort.posts'))
             when 'comments' then (effective_dir == 'asc' ? t('users.index.sort.comments_reverse') : t('users.index.sort.comments'))
             when 'stars' then (effective_dir == 'asc' ? t('users.index.sort.stars_reverse') : t('users.index.sort.stars'))
             when 'az' then (effective_dir == 'asc' ? t('users.index.sort.az') : t('users.index.sort.az_reverse'))
             else (effective_dir == 'asc' ? t('users.index.sort.top_reverse') : t('users.index.sort.top'))
             end %>
          <%= closed_label %>
        </span>
        <%= inline_svg_tag "chevron-down.svg", class: "ml-1 h-5 w-5 text-gray-400" %>
      </button>

      <div class="hidden absolute mt-2 w-64 divide-y divide-gray-100 rounded-md bg-white shadow-lg ring-1 ring-black/5 focus:outline-none left-0 md:left-auto md:right-0 origin-top-left md:origin-top-right" data-dropdown-target="menu">
        <div class="py-1">
          <% # Helper to compute label and dir per option, showing the opposite for current based on direction %>
          <% def sort_link(label_key, reverse_label_key, key, current_sort, current_dir, filters)
               is_current = (current_sort == key)
               label = if is_current
                 # If currently ascending, opposite is descending -> use main label; if descending, opposite is ascending -> use reverse label
                 current_dir == 'asc' ? t(label_key) : t(reverse_label_key)
               else
                 t(label_key)
               end
               dir = if is_current
                 current_dir == 'asc' ? 'desc' : 'asc'
               else
                 # Defaults: az -> asc, others -> desc
                 key == 'az' ? 'asc' : 'desc'
               end
               link_to label, users_path(sort: key, dir: dir, location: filters[:location], company: filters[:company]), class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-900 focus:bg-gray-100 focus:text-gray-900 focus:outline-none cursor-pointer"
             end %>

          <%= sort_link('users.index.sort.top', 'users.index.sort.top_reverse', 'top', @sort, @dir, { location: @filter_location, company: @filter_company }) %>
          <%= sort_link('users.index.sort.new', 'users.index.sort.new_reverse', 'new', @sort, @dir, { location: @filter_location, company: @filter_company }) %>
          <%= sort_link('users.index.sort.projects', 'users.index.sort.projects_reverse', 'projects', @sort, @dir, { location: @filter_location, company: @filter_company }) %>
          <%= sort_link('users.index.sort.posts', 'users.index.sort.posts_reverse', 'posts', @sort, @dir, { location: @filter_location, company: @filter_company }) %>
          <%= sort_link('users.index.sort.comments', 'users.index.sort.comments_reverse', 'comments', @sort, @dir, { location: @filter_location, company: @filter_company }) %>
          <%= sort_link('users.index.sort.stars', 'users.index.sort.stars_reverse', 'stars', @sort, @dir, { location: @filter_location, company: @filter_company }) %>
          <%= sort_link('users.index.sort.az', 'users.index.sort.az_reverse', 'az', @sort, @dir, { location: @filter_location, company: @filter_company }) %>
        </div>
      </div>
    </div>
  </div>
  </div>

  <!-- Active Filters -->
  <% if @filter_location.present? || @filter_company.present? %>
    <div class="bg-gray-50 rounded-lg py-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="text-sm text-gray-600">Filtering by:</span>
          <% if @filter_location.present? %>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-white border border-gray-300">
              <%= inline_svg_tag "location.svg", class: "w-3.5 h-3.5 mr-1 text-gray-500" %>
              <%= @filter_location %>
              <%= link_to "×", users_path(company: @filter_company), class: "ml-2 text-gray-400 hover:text-gray-600 text-lg leading-none" %>
            </span>
          <% end %>
          <% if @filter_company.present? %>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-white border border-gray-300">
              <%= inline_svg_tag "building.svg", class: "w-3.5 h-3.5 mr-1 text-gray-500" %>
              <%= @filter_company %>
              <%= link_to "×", users_path(location: @filter_location), class: "ml-2 text-gray-400 hover:text-gray-600 text-lg leading-none" %>
            </span>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Community Members Grid with Infinite Scroll -->
  <div data-controller="infinite-scroll" class="!-mt-6">
    <%# Split users into 3 columns for desktop, maintaining left-to-right reading order %>
    <% column1_users = [] %>
    <% column2_users = [] %>
    <% column3_users = [] %>
    <% @users.each_with_index do |user, index| %>
      <% case index % 3 %>
      <% when 0 then column1_users << user %>
      <% when 1 then column2_users << user %>
      <% when 2 then column3_users << user %>
      <% end %>
    <% end %>

    <%# Desktop: 3 columns %>
    <div id="users-grid-desktop" class="hidden lg:flex gap-6" data-infinite-scroll-target="entries">
      <div id="users-column-lg-1" class="flex-1 basis-0 min-w-0 space-y-6">
        <% column1_users.each do |user| %>
          <%= render 'users/user_tile', user: user %>
        <% end %>
      </div>
      <div id="users-column-lg-2" class="flex-1 basis-0 min-w-0 space-y-6">
        <% column2_users.each do |user| %>
          <%= render 'users/user_tile', user: user %>
        <% end %>
      </div>
      <div id="users-column-lg-3" class="flex-1 basis-0 min-w-0 space-y-6">
        <% column3_users.each do |user| %>
          <%= render 'users/user_tile', user: user %>
        <% end %>
      </div>
    </div>

    <%# Tablet: 2 columns %>
    <% column1_tablet = [] %>
    <% column2_tablet = [] %>
    <% @users.each_with_index do |user, index| %>
      <% if index % 2 == 0 then column1_tablet << user else column2_tablet << user end %>
    <% end %>

    <div id="users-grid-tablet" class="hidden md:flex lg:hidden gap-6">
      <div id="users-column-md-1" class="flex-1 basis-0 min-w-0 space-y-6">
        <% column1_tablet.each do |user| %>
          <%= render 'users/user_tile', user: user %>
        <% end %>
      </div>
      <div id="users-column-md-2" class="flex-1 basis-0 min-w-0 space-y-6">
        <% column2_tablet.each do |user| %>
          <%= render 'users/user_tile', user: user %>
        <% end %>
      </div>
    </div>

    <%# Mobile: 1 column %>
    <div id="users-grid-mobile" class="md:hidden space-y-6">
      <% @users.each do |user| %>
        <%= render 'users/user_tile', user: user %>
      <% end %>
    </div>

    <!-- Loading indicator -->
    <div data-infinite-scroll-target="loading" class="hidden mt-8 flex justify-center">
      <div class="flex items-center gap-2 text-gray-500">
        <svg class="animate-spin h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span>Loading more...</span>
      </div>
    </div>

    <!-- Pagination (hidden, used for infinite scroll) -->
    <div id="infinite-scroll-pagination" data-infinite-scroll-target="pagination" class="hidden">
      <% if @users.total_pages > 1 %>
        <%= paginate @users %>
      <% end %>
    </div>

    <!-- Sentinel for intersection observer -->
    <% unless @users.last_page? %>
      <div id="infinite-scroll-sentinel" data-infinite-scroll-sentinel class="h-1"></div>
    <% end %>
  </div>

  <!-- Community CTA -->
  <% if user_signed_in? %>
    <div class="mt-8 mb-8 text-center">
      <% tweet_text = "Join us and share what you love about Ruby! https://whyruby.info" %>
      <%= link_to t('users.index.invite_friends'),
          "https://x.com/intent/tweet?text=#{CGI.escape(tweet_text)}",
          target: "_blank",
          rel: "noopener",
          class: "text-gray-400 hover:text-gray-600 transition-colors" %>
    </div>
  <% else %>
    <div class="mt-8 mb-8 text-center">
      <%= link_to t('users.index.join_community'),
          github_auth_with_return_path,
          class: "text-gray-400 hover:text-gray-600 transition-colors" %>
    </div>
  <% end %>
</div>
