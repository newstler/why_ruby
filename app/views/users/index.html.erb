<%# Set page title for community index - just "Ruby Community" %>
<% content_for(:full_title) { t('meta.community.site_name') } %>

<div class="-mt-8 -mx-4 sm:-mx-6 lg:-mx-8 mb-10"
     data-controller="community-map"
     data-community-map-data-url-value="<%= community_map_data_url %>"
     <% if @filter_geo_bounds.present? %>data-community-map-fit-bounds-value="<%= @filter_geo_bounds.to_json %>"<% end %>>
  <div data-community-map-target="container"
       class="w-full h-[250px] sm:h-[350px] md:h-[400px] lg:h-[450px] community-map-landscape bg-gray-100 overflow-hidden">
    <div data-community-map-target="loading"
         class="flex items-center justify-center h-full">
      <div class="flex flex-col items-center gap-3 text-gray-400">
        <svg class="animate-spin h-8 w-8" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span class="text-sm">Loading community map...</span>
      </div>
    </div>
  </div>
</div>

<turbo-frame id="community-content" data-turbo-action="advance">
<% bounds_params = @bounds || {} %>

<%= render "users/community_nav" %>

<%# Override meta tags for community page %>
<% content_for :head do %>
  <!-- SEO Meta Tags -->
  <meta name="description" content="<%= t('meta.users.index.summary') %>">
  <meta name="keywords" content="<%= t('meta.users.index.keywords') %>">
  <link rel="canonical" href="<%= community_root_canonical_url %>">

  <!-- Open Graph / Facebook Meta Tags -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= community_root_canonical_url %>">
  <meta property="og:title" content="<%= t('meta.community.site_name') %>">
  <meta property="og:description" content="<%= t('meta.users.index.summary') %>">
  <meta property="og:image" content="<%= versioned_og_image_url("og-image-community.png") %>">
  <meta property="og:site_name" content="<%= t('meta.community.site_name') %>">
  <meta property="og:locale" content="<%= I18n.locale.to_s.gsub('-', '_') %>">

  <!-- Twitter Card Meta Tags -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content="<%= community_root_canonical_url %>">
  <meta name="twitter:title" content="<%= t('meta.community.site_name') %>">
  <meta name="twitter:description" content="<%= t('meta.users.index.summary') %>">
  <meta name="twitter:image" content="<%= versioned_og_image_url("og-image-community.png") %>">
  <meta name="twitter:site" content="<%= t('meta.social.twitter_site') %>">
  <meta name="twitter:creator" content="<%= t('meta.social.twitter_creator') %>">
<% end %>

<div class="space-y-8">
  <!-- Sticky Header (positioned below main nav) - sticky on tablets (min-width: 768px AND min-height: 600px) but not horizontal phones -->
  <div class="sticky-tablet top-32 z-40 -mx-4 px-4 md:-mx-6 md:px-6 lg:-mx-8 lg:px-8 pt-10 -mt-10 pb-12 md:bg-gradient-to-b md:from-gray-50 md:from-85% md:to-transparent">
    <div class="md:flex md:justify-between w-full">
      <div class="md:flex-1 min-w-0 md:pr-6 md:flex md:flex-col md:justify-end">
        <% if user_signed_in? %>
          <div class="flex items-baseline gap-3 md:gap-4 mb-3">
            <span class="text-5xl md:text-6xl lg:text-7xl font-black text-red-600 tabular-nums"><%= number_with_delimiter(@total_users_count) %></span>
            <h1 class="text-2xl md:text-3xl lg:text-4xl font-bold text-gray-900"><%= t('users.index.developer_count', count: @total_users_count) %></h1>
            <%= link_to community_user_url(current_user), class: "group sm:hidden ml-auto self-center", data: { turbo_frame: "_top" } do %>
              <%= render "shared/gem_avatar", user: current_user, size: "w-10 h-9", badge_size: "map", thick_border: true %>
            <% end %>
          </div>
          <p class="text-lg md:text-xl text-gray-500 max-w-2xl">
            <% if @filter_location.present? %>
              <% location_display = @filter_location.match?(/\A[A-Z]{2}\z/) ? country_name(@filter_location) : @filter_location.sub(/, ([A-Z]{2})$/) { ", #{country_name(Regexp.last_match(1))}" } %>
              from <%= location_display %><%= link_to community_index_path(company: @filter_company, sort: @sort, dir: @dir, open_to_work: @filter_open_to_work ? "1" : nil), class: "inline-flex items-center justify-center w-5 h-5 ml-1.5 rounded-full bg-gray-200 text-gray-400 hover:bg-red-100 hover:text-red-500 transition-colors align-text-bottom", onclick: "window.dispatchEvent(new CustomEvent('map:reset'))" do %><%= inline_svg_tag "x-mark.svg", class: "w-2.5 h-2.5" %><% end %>
            <% elsif @filter_company.present? %>
              working at <%= linkify_company(@filter_company) %><%= link_to community_index_path(location: @filter_location, sort: @sort, dir: @dir, open_to_work: @filter_open_to_work ? "1" : nil), class: "inline-flex items-center justify-center w-5 h-5 ml-1.5 rounded-full bg-gray-200 text-gray-400 hover:bg-red-100 hover:text-red-500 transition-colors align-text-bottom", onclick: "window.dispatchEvent(new CustomEvent('map:reset'))" do %><%= inline_svg_tag "x-mark.svg", class: "w-2.5 h-2.5" %><% end %>
            <% elsif @bounds.present? %>
              from this area
            <% else %>
              from around the world
            <% end %>
          </p>
        <% else %>
          <div class="flex items-center gap-3 md:gap-4 mb-3">
            <%= button_to github_auth_with_return_path, method: :post, data: { turbo: false }, class: "px-6 py-3 text-2xl md:text-3xl font-bold rounded-xl text-white bg-red-600 hover:bg-red-700 cursor-pointer transition-colors shadow-sm" do %>Join<% end %>
            <div class="flex items-baseline gap-3 md:gap-4">
              <span class="text-5xl md:text-6xl lg:text-7xl font-black text-red-600 tabular-nums"><%= number_with_delimiter(@total_users_count) %></span>
              <h1 class="text-2xl md:text-3xl lg:text-4xl font-bold text-gray-900"><%= t('users.index.developer_count', count: @total_users_count) %></h1>
            </div>
          </div>
          <p class="text-lg md:text-xl text-gray-500 max-w-2xl">
            <% if @filter_location.present? %>
              <% location_display = @filter_location.match?(/\A[A-Z]{2}\z/) ? country_name(@filter_location) : @filter_location.sub(/, ([A-Z]{2})$/) { ", #{country_name(Regexp.last_match(1))}" } %>
              from <%= location_display %><%= link_to community_index_path(company: @filter_company, sort: @sort, dir: @dir, open_to_work: @filter_open_to_work ? "1" : nil), class: "inline-flex items-center justify-center w-5 h-5 ml-1.5 rounded-full bg-gray-200 text-gray-400 hover:bg-red-100 hover:text-red-500 transition-colors align-text-bottom", onclick: "window.dispatchEvent(new CustomEvent('map:reset'))" do %><%= inline_svg_tag "x-mark.svg", class: "w-2.5 h-2.5" %><% end %>
            <% elsif @filter_company.present? %>
              working at <%= linkify_company(@filter_company) %><%= link_to community_index_path(location: @filter_location, sort: @sort, dir: @dir, open_to_work: @filter_open_to_work ? "1" : nil), class: "inline-flex items-center justify-center w-5 h-5 ml-1.5 rounded-full bg-gray-200 text-gray-400 hover:bg-red-100 hover:text-red-500 transition-colors align-text-bottom", onclick: "window.dispatchEvent(new CustomEvent('map:reset'))" do %><%= inline_svg_tag "x-mark.svg", class: "w-2.5 h-2.5" %><% end %>
            <% elsif @bounds.present? %>
              from this area
            <% else %>
              from around the world
            <% end %>
            <% unless @filter_location.present? || @filter_company.present? %>
              who <%= t('users.index.passionate_verb', count: @total_users_count) %> passionate about Ruby. <%= link_to "Why Ruby?", cross_domain_url(:primary, "/"), class: "text-gray-700 underline decoration-gray-300 hover:decoration-red-500 hover:text-red-600 transition-colors whitespace-nowrap", data: { turbo_frame: "_top" } %>
            <% end %>
          </p>
        <% end %>
      </div>

    <div class="flex-shrink-0 flex flex-col items-start sm:items-end md:justify-between mt-8 md:mt-0">
      <% if user_signed_in? %>
        <div class="hidden sm:flex sm:flex-col sm:items-end mt-4 mb-1">
          <%= link_to community_user_url(current_user), class: "group", data: { turbo_frame: "_top" } do %>
            <%= render "shared/gem_avatar", user: current_user, size: "w-10 h-9", badge_size: "map", thick_border: true %>
          <% end %>
        </div>
        <% unless current_user.testimonial&.published? %>
          <p class="hidden md:block text-xs text-gray-400 text-right mb-3"><%= link_to "Share why you love Ruby", community_user_url(current_user), class: "underline decoration-gray-300 hover:decoration-red-500 hover:text-red-600 transition-colors", data: { turbo_frame: "_top" } %><br>and get featured on&nbsp;<%= link_to "Why Ruby?", cross_domain_url(:primary, "/"), class: "underline decoration-gray-300 hover:decoration-red-500 hover:text-red-600 transition-colors whitespace-nowrap", data: { turbo_frame: "_top" } %></p>
        <% end %>
      <% end %>
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3 sm:gap-6 md:mt-auto">
      <%= link_to community_index_path(
            open_to_work: @filter_open_to_work ? nil : "1",
            sort: @sort, dir: @dir,
            location: @filter_location, company: @filter_company,
            **bounds_params
          ),
          class: "flex items-center gap-3",
          data: { turbo_frame: "community-content" } do %>
        <span class="relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out <%= @filter_open_to_work ? 'bg-red-600' : 'bg-gray-400' %>">
          <span aria-hidden="true" class="pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out <%= @filter_open_to_work ? 'translate-x-4' : 'translate-x-0' %>"></span>
        </span>
        <span class="text-sm font-medium <%= @filter_open_to_work ? 'text-gray-700' : 'text-gray-400' %>">Open to work</span>
      <% end %>
      <div class="relative" data-controller="dropdown">
      <button type="button" class="flex items-center gap-x-1 text-sm rounded-full cursor-pointer bg-gray-100 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 px-3 py-2" data-action="click->dropdown#toggle click@window->dropdown#hide">
        <span class="text-gray-400"><%= t('users.index.sort_label') %>:</span>
        <span class="text-gray-700 font-medium">
          <% effective_sort = (@sort == 'old' ? 'new' : @sort) %>
          <% effective_dir  = (@sort == 'old' ? 'asc' : @dir) %>
          <% closed_label = case effective_sort
             when 'trending' then (effective_dir == 'asc' ? t('users.index.sort.trending_reverse') : t('users.index.sort.trending'))
             when 'new' then (effective_dir == 'asc' ? t('users.index.sort.new_reverse') : t('users.index.sort.new'))
             when 'projects' then (effective_dir == 'asc' ? t('users.index.sort.projects_reverse') : t('users.index.sort.projects'))
             when 'posts' then (effective_dir == 'asc' ? t('users.index.sort.posts_reverse') : t('users.index.sort.posts'))
             when 'comments' then (effective_dir == 'asc' ? t('users.index.sort.comments_reverse') : t('users.index.sort.comments'))
             when 'stars' then (effective_dir == 'asc' ? t('users.index.sort.stars_reverse') : t('users.index.sort.stars'))
             when 'az' then (effective_dir == 'asc' ? t('users.index.sort.az') : t('users.index.sort.az_reverse'))
             else (effective_dir == 'asc' ? t('users.index.sort.top_reverse') : t('users.index.sort.top'))
             end %>
          <%= closed_label %>
        </span>
        <%= inline_svg_tag "chevron-down.svg", class: "ml-1 h-5 w-5 text-gray-400" %>
      </button>

      <div class="hidden absolute z-50 mt-2 w-64 divide-y divide-gray-100 rounded-md bg-white shadow-lg ring-1 ring-black/5 focus:outline-none left-0 md:left-auto md:right-0 origin-top-left md:origin-top-right" data-dropdown-target="menu">
        <div class="py-1">
          <% # Helper to compute label and dir per option, showing the opposite for current based on direction %>
          <% def sort_link(label_key, reverse_label_key, key, current_sort, current_dir, filters)
               is_current = (current_sort == key)
               label = if is_current
                 # If currently ascending, opposite is descending -> use main label; if descending, opposite is ascending -> use reverse label
                 current_dir == 'asc' ? t(label_key) : t(reverse_label_key)
               else
                 t(label_key)
               end
               dir = if is_current
                 current_dir == 'asc' ? 'desc' : 'asc'
               else
                 # Defaults: az -> asc, others -> desc
                 key == 'az' ? 'asc' : 'desc'
               end
               link_to label, community_index_path(sort: key, dir: dir, location: filters[:location], company: filters[:company], open_to_work: filters[:open_to_work], **filters.fetch(:bounds, {})), class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-900 focus:bg-gray-100 focus:text-gray-900 focus:outline-none cursor-pointer"
             end %>

          <% filter_params = { location: @filter_location, company: @filter_company, bounds: bounds_params, open_to_work: @filter_open_to_work ? "1" : nil } %>
          <%= sort_link('users.index.sort.trending', 'users.index.sort.trending_reverse', 'trending', @sort, @dir, filter_params) %>
          <%= sort_link('users.index.sort.top', 'users.index.sort.top_reverse', 'top', @sort, @dir, filter_params) %>
          <%= sort_link('users.index.sort.new', 'users.index.sort.new_reverse', 'new', @sort, @dir, filter_params) %>
          <%= sort_link('users.index.sort.projects', 'users.index.sort.projects_reverse', 'projects', @sort, @dir, filter_params) %>
          <%= sort_link('users.index.sort.posts', 'users.index.sort.posts_reverse', 'posts', @sort, @dir, filter_params) %>
          <%= sort_link('users.index.sort.comments', 'users.index.sort.comments_reverse', 'comments', @sort, @dir, filter_params) %>
          <%= sort_link('users.index.sort.stars', 'users.index.sort.stars_reverse', 'stars', @sort, @dir, filter_params) %>
          <%= sort_link('users.index.sort.az', 'users.index.sort.az_reverse', 'az', @sort, @dir, filter_params) %>
        </div>
      </div>
    </div>
    </div>
    </div>
  </div>
  </div>

  <!-- Community Members Grid with Infinite Scroll -->
  <div data-controller="infinite-scroll" class="!-mt-10 md:!-mt-6">
    <%# Split users into 3 columns for desktop, maintaining left-to-right reading order %>
    <% column1_users = [] %>
    <% column2_users = [] %>
    <% column3_users = [] %>
    <% @users.each_with_index do |user, index| %>
      <% case index % 3 %>
      <% when 0 then column1_users << user %>
      <% when 1 then column2_users << user %>
      <% when 2 then column3_users << user %>
      <% end %>
    <% end %>

    <%# Desktop: 3 columns %>
    <div id="users-grid-desktop" class="hidden lg:flex gap-6" data-infinite-scroll-target="entries">
      <div id="users-column-lg-1" class="flex-1 basis-0 min-w-0 space-y-6">
        <%= render partial: 'users/user_tile', collection: column1_users, as: :user %>
      </div>
      <div id="users-column-lg-2" class="flex-1 basis-0 min-w-0 space-y-6">
        <%= render partial: 'users/user_tile', collection: column2_users, as: :user %>
      </div>
      <div id="users-column-lg-3" class="flex-1 basis-0 min-w-0 space-y-6">
        <%= render partial: 'users/user_tile', collection: column3_users, as: :user %>
      </div>
    </div>

    <%# Tablet: 2 columns %>
    <% column1_tablet = [] %>
    <% column2_tablet = [] %>
    <% @users.each_with_index do |user, index| %>
      <% if index % 2 == 0 then column1_tablet << user else column2_tablet << user end %>
    <% end %>

    <div id="users-grid-tablet" class="hidden md:flex lg:hidden gap-6">
      <div id="users-column-md-1" class="flex-1 basis-0 min-w-0 space-y-6">
        <%= render partial: 'users/user_tile', collection: column1_tablet, as: :user %>
      </div>
      <div id="users-column-md-2" class="flex-1 basis-0 min-w-0 space-y-6">
        <%= render partial: 'users/user_tile', collection: column2_tablet, as: :user %>
      </div>
    </div>

    <%# Mobile: 1 column %>
    <div id="users-grid-mobile" class="md:hidden space-y-6">
      <%= render partial: 'users/user_tile', collection: @users, as: :user %>
    </div>

    <!-- Loading indicator -->
    <div data-infinite-scroll-target="loading" class="hidden mt-8 flex justify-center">
      <div class="flex items-center gap-2 text-gray-500">
        <svg class="animate-spin h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span>Loading more...</span>
      </div>
    </div>

    <!-- Pagination (hidden, used for infinite scroll) -->
    <div id="infinite-scroll-pagination" data-infinite-scroll-target="pagination" class="hidden">
      <% if @users.total_pages > 1 && !@users.last_page? %>
        <%= link_to "Next", community_index_path(page: @users.next_page, sort: @sort, dir: @dir, location: @filter_location, company: @filter_company, open_to_work: @filter_open_to_work ? "1" : nil, **bounds_params), rel: "next" %>
      <% end %>
    </div>

    <!-- Sentinel for intersection observer -->
    <% unless @users.last_page? %>
      <div id="infinite-scroll-sentinel" data-infinite-scroll-sentinel class="h-1"></div>
    <% end %>
  </div>

  <%# Developers from other parts of the same country (when filtering by location) %>
  <%# Only show this section when all main users are loaded (last page) %>
  <% if @other_country_users&.any? && @bounds.blank? %>
    <% if @users.last_page? %>
      <%= render 'users/other_country_section',
                 other_country_users: @other_country_users,
                 filter_country_code: @filter_country_code,
                 sort: @sort,
                 dir: @dir,
                 filter_location: @filter_location,
                 filter_company: @filter_company %>
    <% else %>
      <%# Placeholder - will be replaced when main users reach last page %>
      <div id="other-country-section-placeholder"></div>
    <% end %>
  <% end %>

  <!-- Community CTA -->
  <% if user_signed_in? %>
    <div class="mt-8 mb-8 text-center">
      <% tweet_text = "Explore Ruby developers' open source projects and connect with the community! Join us → https://rubycommunity.org" %>
      <%= link_to t('users.index.invite_friends'),
          "https://x.com/intent/tweet?text=#{CGI.escape(tweet_text)}",
          target: "_blank",
          rel: "noopener",
          class: "text-gray-400 hover:text-gray-600 transition-colors" %>
    </div>
  <% else %>
    <div class="mt-8 mb-8 text-center">
      <%= button_to github_auth_with_return_path, method: :post, data: { turbo: false }, class: "text-gray-400 hover:text-gray-600 transition-colors cursor-pointer" do %>
        <%= t('users.index.join_community') %>
      <% end %>
    </div>
  <% end %>
</div>
</turbo-frame>
