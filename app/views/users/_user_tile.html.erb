<%# 
  User tile partial - displays a user in a card format
  Locals:
    - user: the user to display
    - rank: optional 1-based position in the list (for medals)
%>

<%= link_to user_path(user), class: "group block bg-white shadow rounded-lg p-6 hover:shadow-lg transition-shadow" do %>
  <div class="flex items-center gap-4">
    <!-- Avatar with rank badge -->
    <div class="relative h-20 w-20 flex-shrink-0">
      <% if user.avatar_url.present? %>
        <%= image_tag user.avatar_url, alt: user.display_name, class: "h-20 w-20 rounded-full" %>
      <% else %>
        <span class="h-20 w-20 rounded-full bg-gray-300 flex items-center justify-center text-3xl font-bold">
          <%= user.display_name.first.upcase %>
        </span>
      <% end %>

      <% if defined?(rank) && rank.present? && rank.to_i <= 3 %>
        <% filter_style = case rank.to_i
          when 1 then ''
          when 2 then 'filter: grayscale(1);'
          when 3 then 'filter: sepia(1) hue-rotate(330deg) saturate(4) brightness(0.9);'
        end %>
        <span class="absolute left-0 bottom-0 block leading-none text-lg select-none z-10" style="<%= [filter_style, 'bottom: 1px;', 'text-shadow: 0 0 2px #fff, 0 0 4px #fff, 0 0 8px rgba(255,255,255,0.95), 0 0 12px rgba(255,255,255,0.9), 1px 1px 0 #fff, -1px 1px 0 #fff, 1px -1px 0 #fff, -1px -1px 0 #fff'].join(' ') %>" title="Top <%= rank %>">🏆</span>
      <% end %>
    </div>
    
    <div class="flex flex-col justify-center flex-1 min-w-0">
      <!-- First line: Name and Stars -->
      <div class="flex items-baseline justify-between mb-1">
        <h2 class="text-2xl font-bold text-gray-900 group-hover:text-red-600 transition-colors">
          <%= user.display_name %>
        </h2>
        <% total_stars = user.respond_to?(:total_github_stars) ? user.total_github_stars.to_i : 0 %>
        <% if total_stars > 0 %>
          <span class="flex items-center text-gray-600 ml-3 whitespace-nowrap leading-none">
            <%= inline_svg_tag "star.svg", class: "w-4 h-4 mr-1 text-yellow-500" %>
            <span class="font-semibold leading-none"><%= total_stars %></span>
          </span>
        <% end %>
      </div>
      
      <!-- Second line: Location and Company -->
      <div class="flex items-center gap-3 text-xs text-gray-400 mb-1">
        <% if user.location.present? %>
          <span class="flex items-center">
            <%= inline_svg_tag "location.svg", class: "w-3 h-3 mr-1" %>
            <%= user.location %>
          </span>
        <% end %>
        
        <% if user.company.present? %>
          <span class="flex items-center">
            <%= inline_svg_tag "building.svg", class: "w-3 h-3 mr-1" %>
            <%= user.company %>
          </span>
        <% end %>
      </div>
      
      <!-- Third line: Stats -->
      <div class="flex items-center gap-3 text-xs">
        <% ruby_repos_count = user.ruby_repositories.size %>
        <% if ruby_repos_count > 0 %>
          <span class="text-gray-600">
            <span class="font-semibold"><%= ruby_repos_count %></span> 
            <span class="text-gray-500"><%= 'Project'.pluralize(ruby_repos_count) %></span>
          </span>
        <% end %>
        
        <% if user.published_posts_count > 0 %>
          <span class="text-gray-600">
            <span class="font-semibold"><%= user.published_posts_count %></span> 
            <span class="text-gray-500"><%= 'Post'.pluralize(user.published_posts_count) %></span>
          </span>
        <% end %>
        
        <% if user.published_comments_count > 0 %>
          <span class="text-gray-600">
            <span class="font-semibold"><%= user.published_comments_count %></span> 
            <span class="text-gray-500"><%= 'Comment'.pluralize(user.published_comments_count) %></span>
          </span>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
