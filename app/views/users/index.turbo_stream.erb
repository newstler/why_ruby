<%# Determine which section we're loading: main users or other country users %>
<% loading_other_country = params[:other_page].present? %>
<% bounds_params = @bounds || {} %>

<% if loading_other_country && @other_country_users.present? %>
  <%# Loading more users for the "other parts of country" section %>
  <% per_page = @other_country_users.limit_value %>
  <% start_index = (@other_country_users.current_page - 1) * per_page %>

  <%# Split other country users into 3 columns for desktop %>
  <% other_col1 = [] %>
  <% other_col2 = [] %>
  <% other_col3 = [] %>
  <% @other_country_users.each_with_index do |user, index| %>
    <% case (start_index + index) % 3 %>
    <% when 0 then other_col1 << user %>
    <% when 1 then other_col2 << user %>
    <% when 2 then other_col3 << user %>
    <% end %>
  <% end %>

  <%# Append to desktop columns %>
  <%= turbo_stream.append "other-users-column-lg-1" do %>
    <% other_col1.each do |user| %>
      <%= render 'users/user_tile', user: user %>
    <% end %>
  <% end %>

  <%= turbo_stream.append "other-users-column-lg-2" do %>
    <% other_col2.each do |user| %>
      <%= render 'users/user_tile', user: user %>
    <% end %>
  <% end %>

  <%= turbo_stream.append "other-users-column-lg-3" do %>
    <% other_col3.each do |user| %>
      <%= render 'users/user_tile', user: user %>
    <% end %>
  <% end %>

  <%# Split into 2 columns for tablet %>
  <% other_tab1 = [] %>
  <% other_tab2 = [] %>
  <% @other_country_users.each_with_index do |user, index| %>
    <% if (start_index + index) % 2 == 0 then other_tab1 << user else other_tab2 << user end %>
  <% end %>

  <%= turbo_stream.append "other-users-column-md-1" do %>
    <% other_tab1.each do |user| %>
      <%= render 'users/user_tile', user: user %>
    <% end %>
  <% end %>

  <%= turbo_stream.append "other-users-column-md-2" do %>
    <% other_tab2.each do |user| %>
      <%= render 'users/user_tile', user: user %>
    <% end %>
  <% end %>

  <%# Append to mobile (single column) %>
  <%= turbo_stream.append "other-users-grid-mobile" do %>
    <% @other_country_users.each do |user| %>
      <%= render 'users/user_tile', user: user %>
    <% end %>
  <% end %>

  <%# Update the pagination links %>
  <%= turbo_stream.replace "other-infinite-scroll-pagination" do %>
    <div id="other-infinite-scroll-pagination" data-infinite-scroll-target="pagination" class="hidden">
      <% if @other_country_users.total_pages > 1 && !@other_country_users.last_page? %>
        <%= link_to "Next", community_index_path(other_page: @other_country_users.next_page, page: params[:page], sort: @sort, dir: @dir, location: @filter_location, company: @filter_company, **bounds_params), rel: "next" %>
      <% end %>
    </div>
  <% end %>

  <%# Update the sentinel - remove if on last page %>
  <%= turbo_stream.replace "other-infinite-scroll-sentinel" do %>
    <% unless @other_country_users.last_page? %>
      <div id="other-infinite-scroll-sentinel" data-infinite-scroll-sentinel class="h-1"></div>
    <% end %>
  <% end %>

<% else %>
  <%# Loading more main users %>
  <% per_page = @users.limit_value %>
  <% start_index = (@users.current_page - 1) * per_page %>

  <%# Split users into 3 columns for desktop %>
  <% column1_users = [] %>
  <% column2_users = [] %>
  <% column3_users = [] %>
  <% @users.each_with_index do |user, index| %>
    <% case (start_index + index) % 3 %>
    <% when 0 then column1_users << user %>
    <% when 1 then column2_users << user %>
    <% when 2 then column3_users << user %>
    <% end %>
  <% end %>

  <%# Append to desktop columns %>
  <%= turbo_stream.append "users-column-lg-1" do %>
    <% column1_users.each do |user| %>
      <%= render 'users/user_tile', user: user %>
    <% end %>
  <% end %>

  <%= turbo_stream.append "users-column-lg-2" do %>
    <% column2_users.each do |user| %>
      <%= render 'users/user_tile', user: user %>
    <% end %>
  <% end %>

  <%= turbo_stream.append "users-column-lg-3" do %>
    <% column3_users.each do |user| %>
      <%= render 'users/user_tile', user: user %>
    <% end %>
  <% end %>

  <%# Split users into 2 columns for tablet %>
  <% column1_tablet = [] %>
  <% column2_tablet = [] %>
  <% @users.each_with_index do |user, index| %>
    <% if (start_index + index) % 2 == 0 then column1_tablet << user else column2_tablet << user end %>
  <% end %>

  <%= turbo_stream.append "users-column-md-1" do %>
    <% column1_tablet.each do |user| %>
      <%= render 'users/user_tile', user: user %>
    <% end %>
  <% end %>

  <%= turbo_stream.append "users-column-md-2" do %>
    <% column2_tablet.each do |user| %>
      <%= render 'users/user_tile', user: user %>
    <% end %>
  <% end %>

  <%# Append to mobile (single column) %>
  <%= turbo_stream.append "users-grid-mobile" do %>
    <% @users.each do |user| %>
      <%= render 'users/user_tile', user: user %>
    <% end %>
  <% end %>

  <%# Update the pagination links %>
  <%= turbo_stream.replace "infinite-scroll-pagination" do %>
    <div id="infinite-scroll-pagination" data-infinite-scroll-target="pagination" class="hidden">
      <% if @users.total_pages > 1 && !@users.last_page? %>
        <%= link_to "Next", community_index_path(page: @users.next_page, sort: @sort, dir: @dir, location: @filter_location, company: @filter_company, **bounds_params), rel: "next" %>
      <% end %>
    </div>
  <% end %>

  <%# Update the sentinel - remove if on last page %>
  <%= turbo_stream.replace "infinite-scroll-sentinel" do %>
    <% unless @users.last_page? %>
      <div id="infinite-scroll-sentinel" data-infinite-scroll-sentinel class="h-1"></div>
    <% end %>
  <% end %>

  <%# When reaching the last page, inject the "other country" section if available %>
  <% if @users.last_page? && @other_country_users&.any? && @bounds.blank? %>
    <%= turbo_stream.replace "other-country-section-placeholder" do %>
      <%= render 'users/other_country_section',
                 other_country_users: @other_country_users,
                 filter_country_code: @filter_country_code,
                 sort: @sort,
                 dir: @dir,
                 filter_location: @filter_location,
                 filter_company: @filter_company %>
    <% end %>
  <% end %>
<% end %>
