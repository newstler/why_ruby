<%# 
  GitHub Sign-in Button Partial
  
  Local variables:
  - mobile: boolean (default: false) - whether this is for mobile layout
  - extra_classes: string (optional) - additional CSS classes
%>
<% mobile = local_assigns.fetch(:mobile, false) %>
<% extra_classes = local_assigns.fetch(:extra_classes, "") %>

<%= button_to github_auth_with_return_path,
    method: :post,
    data: { turbo: false },
    class: "inline-flex items-center #{mobile ? 'w-full justify-center' : ''} gap-2 px-4 py-2 border border-transparent #{mobile ? 'text-base' : 'text-sm'} font-medium rounded-md text-white bg-red-600 hover:bg-red-700 cursor-pointer transition-colors #{extra_classes}" do %>
  <span>Share why you love Ruby</span>
  <span class="text-lg leading-none">&rarr;</span>
<% end %>
